{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/catalog.schema.json",
  "title": "MonadIAM Contract Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupId", "artifactId", "schemaType", "protocol", "path", "producers", "consumers"],
        "properties": {
          "groupId": {
            "type": "string",
            "minLength": 1
          },
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "schemaType": {
            "type": "string",
            "enum": ["JSON", "PROTOBUF"]
          },
          "protocol": {
            "type": "string",
            "enum": ["kafka", "grpc"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "producers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
