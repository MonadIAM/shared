{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/audit-log-archive-value.json",
  "title": "AuditLogArchiveValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "payload"],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": ["ARCHIVE"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "service", "action_type", "entity_type", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "service": { "type": "string" },
        "action_type": { "type": "string" },
        "entity_type": { "type": "string" },
        "created_at": { "type": "string" },
        "actor": { "type": ["string", "null"] },
        "realm": { "type": ["string", "null"] },
        "input": { "type": ["string", "null"] },
        "user_agent": { "type": ["string", "null"] },
        "ip": { "type": ["string", "null"] }
      }
    }
  }
}
