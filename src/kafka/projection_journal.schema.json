{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/projection-journal-value.json",
  "title": "ProjectionJournalValue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actionType",
    "payload"
  ],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": [
        "role-permission-assignment/create",
        "role-permission-assignment/update",
        "role-permission-assignment/purge",
        "account-role-assignment/create",
        "account-role-assignment/update",
        "account-role-assignment/purge",
        "permission-override/create",
        "permission-override/update",
        "permission-override/purge",
        "role-closure/update",
        "permission/create",
        "permission/update",
        "permission/purge",
        "realm/create",
        "realm/update",
        "realm/purge",
        "role/create",
        "role/update",
        "role/purge",
        "projection/checkpoint"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "realm"
      ],
      "properties": {
        "realm": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actionType": {
            "const": "projection/checkpoint"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "realm",
              "items"
            ],
            "properties": {
              "realm": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "scope",
                        "realm"
                      ],
                      "properties": {
                        "scope": {
                          "const": "REALM"
                        },
                        "realm": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "scope",
                        "realm",
                        "account"
                      ],
                      "properties": {
                        "scope": {
                          "const": "ACCOUNT_REALM"
                        },
                        "realm": {
                          "type": "string",
                          "minLength": 1
                        },
                        "account": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
