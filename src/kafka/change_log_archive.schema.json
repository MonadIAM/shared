{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/change-log-archive-value.json",
  "title": "ChangeLogArchiveValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "payload"],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": ["ARCHIVE"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity", "service", "delta", "change_type", "entity_type", "audit_entry", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "entity": { "type": "string" },
        "service": { "type": "string" },
        "delta": { "type": "string" },
        "change_type": { "type": "string" },
        "entity_type": { "type": "string" },
        "audit_entry": { "type": "string" },
        "created_at": { "type": "string" }
      }
    }
  }
}
