{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/account-value.json",
  "title": "AccountValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "payload"],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": ["CREATE", "VERIFY", "PURGE", "EMAIL_VERIFIED", "EMAIL_SELECTED", "EMAIL_PURGED"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": {
        "account": { "type": "string" },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "identifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "value"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "enum": ["email", "phone"]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "replacement": {
          "$ref": "#/properties/payload/properties/identifier"
        },
        "otp": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actionType": { "const": "CREATE" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["account", "identifier", "otp"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actionType": {
            "enum": ["VERIFY", "PURGE"]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "not": {
              "required": ["otp"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actionType": { "enum": ["EMAIL_VERIFIED", "EMAIL_SELECTED", "EMAIL_PURGED"] }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": ["account", "identifier"],
            "properties": {
              "identifier": { "properties": { "type": { "const": "email" } } },
              "replacement": { "properties": { "type": { "const": "email" } } }
            },
            "not": { "required": ["otp"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actionType": { "not": { "const": "EMAIL_PURGED" } }
        }
      },
      "then": {
        "properties": {
          "payload": { "not": { "required": ["replacement"] } }
        }
      }
    }
  ]
}
