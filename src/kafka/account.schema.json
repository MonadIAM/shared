{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/account-value.json",
  "title": "AccountValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "payload"],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": ["CREATE", "VERIFY", "PURGE"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": {
        "account": { "type": "string" },
        "identifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "value"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "enum": ["email", "phone"]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "otp": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actionType": { "const": "CREATE" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["account", "identifier", "otp"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actionType": {
            "enum": ["VERIFY", "PURGE"]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "not": {
              "required": ["otp"]
            }
          }
        }
      }
    }
  ]
}
