{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/realm-value.json",
  "title": "RealmValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "payload"],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": ["RESTORE", "REVOKE", "PURGE"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "realm", "input"],
      "properties": {
        "actor": { "type": "string" },
        "realm": { "type": "string" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": { "type": "number" }
          }
        }
      }
    }
  }
}
