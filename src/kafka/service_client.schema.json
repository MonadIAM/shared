{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/service-client-value.json",
  "title": "ServiceClientValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "payload"],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": ["RESTORE", "CREATE", "REVOKE", "PURGE"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "realm", "input"],
      "properties": {
        "actor": { "type": "string" },
        "realm": { "type": "string" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["application", "code", "id"],
          "properties": {
            "application": { "type": "string" },
            "code": { "type": "string" },
            "id": { "type": "string" }
          }
        }
      }
    }
  }
}
