{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/notification-value.json",
  "title": "NotificationValue",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "CREATE" },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["input"],
              "properties": {
                "actor": { "type": "string" },
                "realm": { "type": "string" },
                "input": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "recipient", "category", "sourceService", "title", "text"],
                  "properties": {
                    "kind": { "const": "CONTENT" },
                    "recipient": { "type": "string" },
                    "category": {
                      "type": "string",
                      "enum": ["SECURITY", "INVITES", "SYSTEM", "OTHER"]
                    },
                    "sourceService": {
                      "type": "string",
                      "enum": [
                        "access-control-service",
                        "notification-service",
                        "organization-service",
                        "certificate-service",
                        "identity-service",
                        "template-service",
                        "hr-service"
                      ]
                    },
                    "dedupKey": { "type": "string" },
                    "delivery": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["channelType", "address"],
                      "properties": {
                        "channelType": { "type": "string", "enum": ["EMAIL", "SMS"] },
                        "address": { "type": "string", "minLength": 1 }
                      }
                    },
                    "language": { "type": "string", "minLength": 1 },
                    "title": { "type": "string" },
                    "text": { "type": "string" }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["input"],
              "properties": {
                "actor": { "type": "string" },
                "realm": { "type": "string" },
                "input": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "recipient", "category", "sourceService", "template"],
                  "properties": {
                    "kind": { "const": "TEMPLATE" },
                    "recipient": { "type": "string" },
                    "category": {
                      "type": "string",
                      "enum": ["SECURITY", "INVITES", "SYSTEM", "OTHER"]
                    },
                    "sourceService": {
                      "type": "string",
                      "enum": [
                        "access-control-service",
                        "notification-service",
                        "organization-service",
                        "certificate-service",
                        "identity-service",
                        "template-service",
                        "hr-service"
                      ]
                    },
                    "dedupKey": { "type": "string" },
                    "delivery": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["channelType", "address"],
                      "properties": {
                        "channelType": { "type": "string", "enum": ["EMAIL", "SMS"] },
                        "address": { "type": "string", "minLength": 1 }
                      }
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "template": {
                      "type": "string",
                      "enum": [
                        "PASSWORD_CHANGED_VIA_RECOVERY_CODE",
                        "PASSWORD_CHANGED_VIA_OTP",
                        "PASSWORD_CHANGED",
                        "SECOND_FACTOR_ENABLED",
                        "SECOND_FACTOR_RESET",
                        "SECOND_FACTOR_PURGED",
                        "RECOVERY_CODES_REGENERATED",
                        "IDENTIFIER_PURGED",
                        "LOGIN_ALERT",
                        "IDENTIFIER_VERIFICATION_OTP",
                        "ACCOUNT_VERIFICATION_OTP",
                        "RESET_PASSWORD_OTP",
                        "LOGIN_OTP",
                        "REAUTHENTICATION_OTP",
                        "ASSIGNMENT_GRANTED",
                        "ASSIGNMENT_REVOKED",
                        "REALM_EXCLUDED",
                        "INVITE_CANCELLED",
                        "INVITE_RECEIVED",
                        "HR_APPROVAL_REQUIRED",
                        "HR_APPROVAL_REASSIGNED",
                        "HR_REQUEST_RETURNED",
                        "HR_REQUEST_REJECTED",
                        "HR_REQUEST_APPROVED",
                        "HR_REQUEST_APPLIED",
                        "HR_REQUEST_FAILED"
                      ]
                    },
                    "language": { "type": "string" }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "template": {
                            "enum": [
                              "HR_APPROVAL_REQUIRED",
                              "HR_APPROVAL_REASSIGNED",
                              "HR_REQUEST_RETURNED",
                              "HR_REQUEST_REJECTED",
                              "HR_REQUEST_APPROVED",
                              "HR_REQUEST_APPLIED",
                              "HR_REQUEST_FAILED"
                            ]
                          }
                        }
                      },
                      "then": {
                        "required": ["dedupKey", "params"],
                        "properties": {
                          "sourceService": { "const": "hr-service" },
                          "params": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["requestId", "requestType"],
                            "properties": {
                              "requestId": {
                                "type": "string",
                                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                              },
                              "requestType": {
                                "enum": [
                                  "HIRE", "REHIRE", "TRANSFER", "CHANGE_TERMS", "TERMINATE",
                                  "ABSENCE", "OVERTIME", "LEAVE_ADJUSTMENT", "CANCEL_REQUEST"
                                ]
                              }
                            }
                          }
                        },
                        "not": { "required": ["delivery"] }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "CANCEL" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input"],
          "properties": {
            "actor": { "type": "string" },
            "realm": { "type": "string" },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dedupKey", "override"],
              "properties": {
                "dedupKey": { "type": "string" },
                "override": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["input"],
                      "properties": {
                        "actor": { "type": "string" },
                        "realm": { "type": "string" },
                        "input": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["kind", "recipient", "category", "sourceService", "title", "text"],
                          "properties": {
                            "kind": { "const": "CONTENT" },
                            "recipient": { "type": "string" },
                            "category": {
                              "type": "string",
                              "enum": ["SECURITY", "INVITES", "SYSTEM", "OTHER"]
                            },
                            "sourceService": {
                              "type": "string",
                              "enum": [
                                "access-control-service",
                                "notification-service",
                                "organization-service",
                                "certificate-service",
                                "identity-service",
                                "template-service",
                                "hr-service"
                              ]
                            },
                            "dedupKey": { "type": "string" },
                            "delivery": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["channelType", "address"],
                              "properties": {
                                "channelType": { "type": "string", "enum": ["EMAIL", "SMS"] },
                                "address": { "type": "string", "minLength": 1 }
                              }
                            },
                            "language": { "type": "string", "minLength": 1 },
                            "title": { "type": "string" },
                            "text": { "type": "string" }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["input"],
                      "properties": {
                        "actor": { "type": "string" },
                        "realm": { "type": "string" },
                        "input": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["kind", "recipient", "category", "sourceService", "template"],
                          "properties": {
                            "kind": { "const": "TEMPLATE" },
                            "recipient": { "type": "string" },
                            "category": {
                              "type": "string",
                              "enum": ["SECURITY", "INVITES", "SYSTEM", "OTHER"]
                            },
                            "sourceService": {
                              "type": "string",
                              "enum": [
                                "access-control-service",
                                "notification-service",
                                "organization-service",
                                "certificate-service",
                                "identity-service",
                                "template-service",
                                "hr-service"
                              ]
                            },
                            "dedupKey": { "type": "string" },
                            "delivery": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["channelType", "address"],
                              "properties": {
                                "channelType": { "type": "string", "enum": ["EMAIL", "SMS"] },
                                "address": { "type": "string", "minLength": 1 }
                              }
                            },
                            "params": {
                              "type": "object",
                              "additionalProperties": { "type": "string" }
                            },
                            "template": {
                              "type": "string",
                              "enum": [
                                "PASSWORD_CHANGED_VIA_RECOVERY_CODE",
                                "PASSWORD_CHANGED_VIA_OTP",
                                "PASSWORD_CHANGED",
                                "SECOND_FACTOR_ENABLED",
                                "SECOND_FACTOR_RESET",
                                "SECOND_FACTOR_PURGED",
                                "RECOVERY_CODES_REGENERATED",
                                "IDENTIFIER_PURGED",
                                "LOGIN_ALERT",
                                "IDENTIFIER_VERIFICATION_OTP",
                                "ACCOUNT_VERIFICATION_OTP",
                                "RESET_PASSWORD_OTP",
                                "LOGIN_OTP",
                                "REAUTHENTICATION_OTP",
                                "ASSIGNMENT_GRANTED",
                                "ASSIGNMENT_REVOKED",
                                "REALM_EXCLUDED",
                                "INVITE_CANCELLED",
                                "INVITE_RECEIVED",
                                "HR_APPROVAL_REQUIRED",
                                "HR_APPROVAL_REASSIGNED",
                                "HR_REQUEST_RETURNED",
                                "HR_REQUEST_REJECTED",
                                "HR_REQUEST_APPROVED",
                                "HR_REQUEST_APPLIED",
                                "HR_REQUEST_FAILED"
                              ]
                            },
                            "language": { "type": "string" }
                          },
                          "allOf": [
                            {
                              "if": {
                                "properties": {
                                  "template": {
                                    "enum": [
                                      "HR_APPROVAL_REQUIRED",
                                      "HR_APPROVAL_REASSIGNED",
                                      "HR_REQUEST_RETURNED",
                                      "HR_REQUEST_REJECTED",
                                      "HR_REQUEST_APPROVED",
                                      "HR_REQUEST_APPLIED",
                                      "HR_REQUEST_FAILED"
                                    ]
                                  }
                                }
                              },
                              "then": {
                                "required": ["dedupKey", "params"],
                                "properties": {
                                  "sourceService": { "const": "hr-service" },
                                  "params": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["requestId", "requestType"],
                                    "properties": {
                                      "requestId": {
                                        "type": "string",
                                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                                      },
                                      "requestType": {
                                        "enum": [
                                          "HIRE", "REHIRE", "TRANSFER", "CHANGE_TERMS", "TERMINATE",
                                          "ABSENCE", "OVERTIME", "LEAVE_ADJUSTMENT", "CANCEL_REQUEST"
                                        ]
                                      }
                                    }
                                  }
                                },
                                "not": { "required": ["delivery"] }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "CANCEL" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["realm", "input"],
          "properties": {
            "actor": { "type": "string" },
            "realm": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["invalidate", "recipient", "sourceService", "dedupKey"],
              "properties": {
                "invalidate": { "const": true },
                "recipient": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "sourceService": { "const": "hr-service" },
                "dedupKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  ]
}
