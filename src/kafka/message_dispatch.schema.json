{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/message-dispatch-value.json",
  "title": "MessageDispatchValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "payload"],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": ["DISPATCH"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": { "type": "string" }
      }
    }
  }
}
