{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.monadiam.local/kafka/reauthentication-value.json",
  "title": "ReauthenticationValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "payload"],
  "properties": {
    "actionType": {
      "type": "string",
      "enum": ["GRANT"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiresAt", "session"],
      "properties": {
        "expiresAt": { "type": "number" },
        "session": { "type": "string" },
        "proof": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["method"],
              "properties": {
                "method": { "enum": ["password", "otp"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "factor"],
              "properties": {
                "method": { "const": "totp" },
                "factor": { "type": "string", "format": "uuid" }
              }
            }
          ]
        }
      }
    }
  }
}
